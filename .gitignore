# Allowlist: ignore everything, then opt back in to exactly what belongs in the repo.
# This keeps build output, Visual Studio caches and unused local files out by default.
*
!*/

!.gitignore
!.gitattributes
!README.md
!LICENSE
!VERSION
!.github/workflows/*.yml
!MazeBeasts.sln
!tools/packassets.ps1
!tools/make-server-bundle.ps1

# Project and source
!MazeBeasts/MazeBeasts.vcxproj
!MazeBeasts/MazeBeasts.vcxproj.filters
!MazeBeasts/MazeBeasts.vcxproj.user
!MazeBeasts/mazebeasts.cpp
!MazeBeasts/glad.c
!MazeBeasts/net.h
!MazeBeasts/net.cpp
!MazeBeasts/protocol.h
!MazeBeasts/world.h
!MazeBeasts/world.cpp

# Dedicated server (shares the files above; builds with Visual Studio or, on Linux, make)
!MazeBeastsServer/server.cpp
!MazeBeastsServer/Makefile
!MazeBeastsServer/README.md
!MazeBeastsServer/MazeBeastsServer.vcxproj
!MazeBeastsServer/MazeBeastsServer.vcxproj.filters

# ENet (reliable UDP for multiplayer), vendored source - see MazeBeasts/enet/VERSION.txt
!MazeBeasts/enet/**

# Third-party headers and the GLFW static libraries (Debug links glfw3.lib, Release glfw3_mt.lib)
!MazeBeasts/include/**
!MazeBeasts/lib-vc2022/glfw3.lib
!MazeBeasts/lib-vc2022/glfw3_mt.lib

# Game assets (packed into assets.dat by tools/packassets.ps1)
!MazeBeasts/LiberationSans-Regular.ttf
!MazeBeasts/LiberationSans-LICENSE.txt
!MazeBeasts/wall_texture.png
!MazeBeasts/boundary_texture.png
!MazeBeasts/monster_texture.png
!MazeBeasts/monster2_texture.png
!MazeBeasts/medpack.png
!MazeBeasts/cavewalltexture.jpg
!MazeBeasts/cavefloorgrok.jpg
!MazeBeasts/monster_sound.flac
!MazeBeasts/boss_sound.flac
